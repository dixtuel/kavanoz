
# Optional: Cloudflare Web Analytics site token (cookieless RUM). Leave unset to disable.
CF_WEB_ANALYTICS_TOKEN=

# VDS worker uses this sender with the local Postfix relay; no mailbox account is needed.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_TLS_SERVERNAME=mail.example.com
MAIL_FROM=Sanal Kavanoz <no-reply@example.com>
