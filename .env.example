# Turso (libSQL) — ayrı bir proje/veritabanı, dilek-ağacı'nınkiyle karışmasın
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# At-rest şifreleme anahtarı — 32 byte, hex (64 karakter). Üret: openssl rand -hex 32
KAVANOZ_ENC_KEY=

# hCaptcha — kavanoz.sely.tr için AYRI bir site key (dilek-ağacı'nınkini paylaşma)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# NVIDIA NIM içerik moderasyonu (dilek-ağacı ile aynı hesap/model yeniden kullanılabilir)
NIM_API_KEY=
NIM_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
NIM_TIMEOUT_MS=8000

# Yerel Postfix'e kimlik doğrulamasız röle (mikoshi-ai web_panel.py ile aynı desen —
# "no-reply" diye bir sistem/PAM kullanıcısı YOK, mynetworks zaten loopback/docker-bridge'e güveniyor).
# Container'dan host'a ulaşmak için docker-compose.yml'de `extra_hosts: host.docker.internal:host-gateway` var.
SMTP_HOST=host.docker.internal
SMTP_PORT=25
MAIL_FROM=Sanal Kavanoz <no-reply@dixtuel.tr>

# Bir kavanozun kaç nottan sonra "dolup" rafa kaldırılacağı
JAR_CAPACITY=50

CORS_ALLOWED_ORIGINS=https://kavanoz.sely.tr
PORT=3030
