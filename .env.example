# Turso (libSQL) — ayrı bir proje/veritabanı, dilek-ağacı'nınkiyle karışmasın
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# At-rest şifreleme anahtarı — 32 byte, hex (64 karakter). Üret: openssl rand -hex 32
KAVANOZ_ENC_KEY=

# hCaptcha — kavanoz.dxtl.com.tr için AYRI bir site key (dilek-ağacı'nınkini paylaşma)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# NVIDIA NIM içerik moderasyonu (dilek-ağacı ile aynı hesap/model yeniden kullanılabilir)
NIM_API_KEY=
NIM_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
NIM_TIMEOUT_MS=8000

# Yerel Postfix üzerinden gönderim (mail-api.env ile aynı desen, kavanoz'a özel kimlik bilgisi)
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sanal Kavanoz <no-reply@dxtl.com.tr>

# Bir kavanozun kaç nottan sonra "dolup" rafa kaldırılacağı
JAR_CAPACITY=50

CORS_ALLOWED_ORIGINS=https://kavanoz.dxtl.com.tr
PORT=3030
